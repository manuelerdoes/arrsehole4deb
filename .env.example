# =============================================================================
#  arr stack - the only file you need to edit.   cp .env.example .env
#  Values containing spaces or special characters ($ # ! ...) must be wrapped
#  in 'single quotes'.
# =============================================================================

# ---- Locations --------------------------------------------------------------
# App configuration/databases (small, wants fast disk)
CONFIG_DIR=/opt/arr/config
# Media + downloads. MUST be one filesystem so imports are instant hardlinks.
#   $DATA_DIR/torrents/{movies,tv,incomplete}   <- qBittorrent
#   $DATA_DIR/media/{movies,tv}                 <- Radarr/Sonarr/Plex/Jellyfin
DATA_DIR=/srv/data

# ---- One login for everything -----------------------------------------------
# Used for: Radarr, Sonarr, Prowlarr, Bazarr, qBittorrent, Jellyfin (admin)
ADMIN_USER=admin
ADMIN_PASSWORD=

# ---- VPN (WireGuard via Gluetun) ---------------------------------------------
# protonvpn | windscribe | none
#   none = qBittorrent runs WITHOUT a VPN (for testing): your home IP address is
#   visible to every peer. The WIREGUARD_/VPN_ settings below are then ignored.
#   Switch at any time by changing this value and re-running ./setup.sh.
VPN_SERVICE_PROVIDER=protonvpn

# ProtonVPN: account.proton.me -> Downloads -> WireGuard configuration
#   Platform: Router, enable "NAT-PMP (Port Forwarding)", create, then copy
#   the PrivateKey value. ADDRESSES and PRESHARED_KEY stay empty.
# Windscribe: windscribe.com -> My Account -> WireGuard config generator.
#   Copy PrivateKey, Address and PresharedKey from the generated file.
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
WIREGUARD_PRESHARED_KEY=

# Server choice (comma separated, empty = any)
#   ProtonVPN uses countries, e.g. Switzerland  or  'Switzerland,Netherlands'
VPN_SERVER_COUNTRIES=Switzerland
#   Windscribe uses regions (leave VPN_SERVER_COUNTRIES empty then)
VPN_SERVER_REGIONS=

# Incoming port for torrents
#   ProtonVPN: on = fully automatic, nothing to renew (paid plan + NAT-PMP key)
#   Windscribe: set this to off and put your ephemeral port (My Account ->
#     Port Forwarding, expires after 7 days) into VPN_INPUT_PORT, then re-run
#     ./setup.sh whenever it changes.
VPN_PORT_FORWARDING=on
VPN_INPUT_PORT=

# ---- Remote access over HTTPS (optional) --------------------------------------
# Fill in one or both names to publish Jellyfin / Seerr on the internet through
# a Caddy reverse proxy with automatic Let's Encrypt certificates. Needs:
#   - DNS A records for these names pointing at your public IP
#   - router forwarding TCP 80 + 443 to this server
# Empty = LAN only (no proxy container is started).
JELLYFIN_DOMAIN=
SEERR_DOMAIN=
# Optional: e-mail for certificate expiry notices from Let's Encrypt
ACME_EMAIL=

# ---- Preferences ------------------------------------------------------------
# Quality profile Seerr uses for requests. Radarr/Sonarr defaults:
#   Any | SD | HD-720p | HD-1080p | Ultra-HD | "HD - 720p/1080p"
QUALITY_PROFILE=HD-1080p
# Metadata language/country for the Plex + Jellyfin libraries
METADATA_LANGUAGE=en
METADATA_COUNTRY=US
# Web UI login for Radarr/Sonarr/Prowlarr: enabled | disabledForLocalAddresses
AUTH_REQUIRED=enabled
# How long qBittorrent keeps seeding (uploading) after a download completes:
#   0     = stop immediately when the download is finished
#   1     = seed until as much was uploaded as downloaded (1.5, 2 ... likewise)
#   empty = seed forever
SEED_RATIO_LIMIT=1
# on = also run Watchtower (nightly image updates at 04:00)
AUTO_UPDATE=off

# ---- Auto-detected / generated by setup.sh (leave empty) --------------------
PUID=
PGID=
TZ=
HOST_IP=
LAN_SUBNET=
RADARR_API_KEY=
SONARR_API_KEY=
PROWLARR_API_KEY=
BAZARR_API_KEY=
COMPOSE_PROFILES=
JELLYFIN_PUBLISHED_URL=
